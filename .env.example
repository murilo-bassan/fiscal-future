DATABASE_URL="file:./dev.db"
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
APP_URL="http://localhost:3000"
# Criptografa os tokens dos provedores de emissão (64 caracteres hex). Gere como o AUTH_SECRET.
ENCRYPTION_KEY=""

# E-mails (link de redefinição de senha) pelo Resend. Fora de produção, sem chave, o e-mail sai no console.
# EMAIL_FROM precisa ser de um domínio verificado no Resend, ex.: "Fiscal Future <nao-responda@seudominio.com.br>".
RESEND_API_KEY=""
EMAIL_FROM=""

# Opcional: classificação de produtos com IA
ANTHROPIC_API_KEY=""

# Opcional: cobrança. Sem estas chaves, o checkout fica em modo demonstração.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ESSENCIAL=""
STRIPE_PRICE_PROFISSIONAL=""
STRIPE_PRICE_CONTADOR=""

# Opcional: aviso do Focus NFe quando a nota muda de status. Gere como o AUTH_SECRET.
# No painel do Focus, crie um gatilho com a URL https://SEU_DOMINIO/api/focus/webhook e o header
# Authorization com exatamente este valor. Sem ele, o status só muda pela rotina periódica ou pelo botão.
FOCUS_WEBHOOK_SECRET=""
# Rotina periódica (/api/cron, a cada 10 min pelo vercel.json): a Vercel envia "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""
